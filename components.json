  },
  {
   "file": "pages/reports.html",
   "screen": "reports",
   "pattern": "Charts"
  },
  {
   "file": "pages/tables.html",
   "screen": "tables",
   "pattern": "Grouping, inline edit, column picker"
  },
  {
   "file": "pages/form.html",
   "screen": "form",
